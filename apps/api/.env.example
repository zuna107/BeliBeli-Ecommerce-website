# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://beibeli:beibeli_pass@localhost:5432/beibeli_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-random-64-char-hex-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-hex-string
COOKIE_SECRET=change-this-to-yet-another-random-secret

# ─── Email / Mailhog ─────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Leave empty for Mailhog (no auth required)
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@beibeli.local

# ─── File Upload ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads

# ─── Xendit (Sandbox) ────────────────────────────────────────────────────────
# Get from: https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=xnd_development_REPLACE_WITH_YOUR_KEY
XENDIT_CALLBACK_TOKEN=REPLACE_WITH_YOUR_WEBHOOK_CALLBACK_TOKEN
XENDIT_WEBHOOK_URL=https://YOUR_NGROK_URL/payments/xendit/webhook

# ─── Komerce API (Shipping) ───────────────────────────────────────────────────
# Get from: https://app.komerce.id/api-access
KOMERCE_API_KEY=REPLACE_WITH_YOUR_KOMERCE_API_KEY
KOMERCE_API_URL=https://api.komerce.id

# ─── Frontend (SvelteKit PUBLIC_ vars) ────────────────────────────────────────
PUBLIC_API_URL=http://localhost:3000
