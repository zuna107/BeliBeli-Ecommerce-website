// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  buyer
  seller
  admin
}

enum Gender {
  male
  female
  other
}

enum ShopStatus {
  active
  suspended
  closed
}

enum ProductStatus {
  active
  inactive
  deleted
}

enum ProductCondition {
  new
  used
}

enum OrderShopStatus {
  pending
  processing
  shipped
  delivered
  completed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  expired
}

enum VoucherType {
  fixed
  percentage
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(100)
  email          String    @unique @db.VarChar(255)
  phone          String?   @db.VarChar(20)
  password_hash  String    @db.VarChar(255)
  avatar_url     String?
  bio            String?
  role           UserRole  @default(buyer)
  email_verified Boolean   @default(false)
  birth_date     DateTime? @db.Date
  gender         Gender?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  shop          Shop?
  addresses     Address[]
  cart          Cart?
  orders        Order[]
  reviews       Review[]
  wishlists     Wishlist[]
  shop_follows  ShopFollower[]
  notifications Notification[]

  @@map("users")
}

model Shop {
  id          String     @id @default(uuid())
  owner_id    String     @unique
  name        String     @unique @db.VarChar(100)
  slug        String     @unique @db.VarChar(120)
  description String?
  logo_url    String?
  banner_url  String?
  city        String     @db.VarChar(100)
  komerce_city_id String? @db.VarChar(20)
  status      ShopStatus @default(active)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  owner       User          @relation(fields: [owner_id], references: [id])
  products    Product[]
  order_shops OrderShop[]
  followers   ShopFollower[]
  vouchers    Voucher[]

  @@map("shops")
}

model Address {
  id             String   @id @default(uuid())
  user_id        String
  label          String   @db.VarChar(50)
  recipient_name String   @db.VarChar(100)
  phone          String   @db.VarChar(20)
  province       String   @db.VarChar(100)
  city           String   @db.VarChar(100)
  district       String   @db.VarChar(100)
  postal_code    String   @db.VarChar(10)
  detail         String
  komerce_city_id String  @db.VarChar(20)
  is_default     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user   User    @relation(fields: [user_id], references: [id])
  orders Order[]

  @@map("addresses")
}

model Category {
  id         String     @id @default(uuid())
  parent_id  String?
  name       String     @db.VarChar(100)
  slug       String     @unique @db.VarChar(120)
  icon_url   String?
  level      Int        @default(0)
  created_at DateTime   @default(now())

  parent     Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children   Category[] @relation("CategoryTree")
  products   Product[]

  @@map("categories")
}

model Product {
  id           String           @id @default(uuid())
  shop_id      String
  category_id  String
  name         String           @db.VarChar(255)
  slug         String           @unique @db.VarChar(300)
  description  String
  base_price   Decimal          @db.Decimal(15, 2)
  weight_gram  Int
  condition    ProductCondition @default(new)
  min_order    Int              @default(1)
  status       ProductStatus    @default(active)
  total_sold   Int              @default(0)
  avg_rating   Float            @default(0)
  review_count Int              @default(0)
  created_at   DateTime         @default(now())
  updated_at   DateTime         @updatedAt

  shop     Shop              @relation(fields: [shop_id], references: [id])
  category Category          @relation(fields: [category_id], references: [id])
  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]
  wishlists Wishlist[]

  @@index([shop_id])
  @@index([category_id])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id         String  @id @default(uuid())
  product_id String
  url        String
  is_primary Boolean @default(false)
  order      Int     @default(0)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id           String  @id @default(uuid())
  product_id   String
  variant_name String  @db.VarChar(100)
  sku          String? @db.VarChar(100)
  price        Decimal @db.Decimal(15, 2)
  stock        Int     @default(0)
  image_url    String?
  is_active    Boolean @default(true)

  product    Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cart_items CartItem[]
  order_items OrderItem[]

  @@index([product_id])
  @@map("product_variants")
}

model Cart {
  id         String   @id @default(uuid())
  user_id    String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user  User       @relation(fields: [user_id], references: [id])
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                 String   @id @default(uuid())
  cart_id            String
  product_variant_id String
  quantity           Int
  added_at           DateTime @default(now())

  cart    Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [product_variant_id], references: [id])

  @@unique([cart_id, product_variant_id])
  @@map("cart_items")
}

model Order {
  id                    String        @id @default(uuid())
  order_number          String        @unique @db.VarChar(30)
  buyer_id              String
  shipping_address_id   String
  total_product_price   Decimal       @db.Decimal(15, 2)
  total_shipping_cost   Decimal       @db.Decimal(15, 2)
  total_voucher_discount Decimal      @default(0) @db.Decimal(15, 2)
  grand_total           Decimal       @db.Decimal(15, 2)
  payment_status        PaymentStatus @default(pending)
  notes                 String?
  created_at            DateTime      @default(now())
  expires_at            DateTime
  paid_at               DateTime?

  buyer            User           @relation(fields: [buyer_id], references: [id])
  shipping_address Address        @relation(fields: [shipping_address_id], references: [id])
  order_shops      OrderShop[]
  payment          Payment?
  order_vouchers   OrderVoucher[]

  @@index([buyer_id])
  @@index([payment_status])
  @@map("orders")
}

model OrderShop {
  id              String          @id @default(uuid())
  order_id        String
  shop_id         String
  status          OrderShopStatus @default(pending)
  courier_name    String?         @db.VarChar(50)
  courier_service String?         @db.VarChar(50)
  tracking_number String?         @db.VarChar(100)
  shipping_cost   Decimal         @db.Decimal(15, 2)
  updated_at      DateTime        @updatedAt

  order       Order            @relation(fields: [order_id], references: [id])
  shop        Shop             @relation(fields: [shop_id], references: [id])
  items       OrderItem[]
  status_logs OrderStatusLog[]

  @@index([order_id])
  @@index([shop_id])
  @@map("order_shops")
}

model OrderItem {
  id                 String  @id @default(uuid())
  order_shop_id      String
  product_variant_id String
  product_snapshot   Json    // JSONB: { name, image_url, variant_name, shop_name }
  quantity           Int
  unit_price         Decimal @db.Decimal(15, 2)
  subtotal           Decimal @db.Decimal(15, 2)

  order_shop OrderShop      @relation(fields: [order_shop_id], references: [id])
  variant    ProductVariant @relation(fields: [product_variant_id], references: [id])
  review     Review?

  @@map("order_items")
}

model OrderStatusLog {
  id            String          @id @default(uuid())
  order_shop_id String
  status        OrderShopStatus
  note          String?
  created_at    DateTime        @default(now())

  order_shop OrderShop @relation(fields: [order_shop_id], references: [id])

  @@map("order_status_logs")
}

model Payment {
  id               String        @id @default(uuid())
  order_id         String        @unique
  payment_gateway  String        @default("xendit") @db.VarChar(50)
  xendit_invoice_id String?      @unique @db.VarChar(255)
  payment_method   String?       @db.VarChar(100)
  amount           Decimal       @db.Decimal(15, 2)
  status           PaymentStatus @default(pending)
  invoice_url      String?
  gateway_response Json?         // JSONB: raw response dari Xendit
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  order Order @relation(fields: [order_id], references: [id])

  @@map("payments")
}

model Review {
  id            String    @id @default(uuid())
  order_item_id String    @unique
  product_id    String
  reviewer_id   String
  rating        Int       // 1–5
  comment       String?
  seller_reply  String?
  created_at    DateTime  @default(now())
  replied_at    DateTime?

  order_item OrderItem     @relation(fields: [order_item_id], references: [id])
  product    Product       @relation(fields: [product_id], references: [id])
  reviewer   User          @relation(fields: [reviewer_id], references: [id])
  images     ReviewImage[]

  @@index([product_id])
  @@map("reviews")
}

model ReviewImage {
  id        String @id @default(uuid())
  review_id String
  url       String
  order     Int    @default(0)

  review Review @relation(fields: [review_id], references: [id], onDelete: Cascade)

  @@map("review_images")
}

model Wishlist {
  id         String   @id @default(uuid())
  user_id    String
  product_id String
  added_at   DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id])
  @@map("wishlists")
}

model ShopFollower {
  id          String   @id @default(uuid())
  user_id     String
  shop_id     String
  followed_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])
  shop Shop @relation(fields: [shop_id], references: [id])

  @@unique([user_id, shop_id])
  @@map("shop_followers")
}

model Voucher {
  id           String      @id @default(uuid())
  shop_id      String?     // NULL = voucher platform-wide
  code         String      @unique @db.VarChar(50)
  type         VoucherType
  value        Decimal     @db.Decimal(15, 2)
  min_purchase Decimal     @default(0) @db.Decimal(15, 2)
  max_discount Decimal?    @db.Decimal(15, 2)
  usage_limit  Int
  used_count   Int         @default(0)
  valid_from   DateTime
  valid_until  DateTime
  is_active    Boolean     @default(true)

  shop          Shop?          @relation(fields: [shop_id], references: [id])
  order_vouchers OrderVoucher[]

  @@map("vouchers")
}

model OrderVoucher {
  id              String  @id @default(uuid())
  order_id        String
  voucher_id      String
  discount_amount Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [order_id], references: [id])
  voucher Voucher @relation(fields: [voucher_id], references: [id])

  @@map("order_vouchers")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String   @db.VarChar(50)
  title      String   @db.VarChar(255)
  message    String
  data       Json?    // JSONB: metadata (order_id, dsb)
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, is_read])
  @@map("notifications")
}
